# LLM (required — OpenAI-compatible API)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_PROVIDER=openai-compatible
LLM_MAX_OUTPUT_TOKENS=1200

# Optional versioned pricing. Leave rates empty when the model price is unknown.
MODEL_PRICING_VERSION=unconfigured
MODEL_INPUT_COST_PER_1M=
MODEL_OUTPUT_COST_PER_1M=

# Per-run safety budgets
MAX_LLM_CALLS=6
MAX_TOTAL_TOKENS=12000
MAX_RUN_SECONDS=55
AGENT_REQUEST_TIMEOUT_SECONDS=60

# Agent state checkpoint (optional; defaults to data/agent_checkpoints.db)
AGENT_CHECKPOINT_DB_PATH=data/agent_checkpoints.db

# Redis (optional — RAG cache, set REDIS_ENABLED=true to enable)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
RAG_CACHE_TTL=900

# LangSmith (optional — tracing)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shopsift
