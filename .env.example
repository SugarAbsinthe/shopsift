# 复制为 .env；修改后重启后端。

# 模型 API（需支持工具调用；以下为 DeepSeek 示例）
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MAX_OUTPUT_TOKENS=4096

# 嵌入模型（更换后需重建索引）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 首次下载用 0；完整缓存后两项可设为 1。
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
# 本地缓存路径可选；Docker 保留默认缓存卷。
# HF_HUB_CACHE=data/model_cache

# 每轮预算：调用次数、已报告总 Token、运行秒数
MAX_LLM_CALLS=10
MAX_TOTAL_TOKENS=32768
MAX_RUN_SECONDS=120
# 同步请求超时（秒），应大于运行预算。
AGENT_REQUEST_TIMEOUT_SECONDS=150

# 可选路径覆盖（默认位于仓库 data/）
# PRODUCT_DB_PATH=data/products.db
# PRODUCT_CHROMA_DIR=data/product_chroma_db
# PROFILE_DB_PATH=data/profiles.db
# PROFILE_CHROMA_DIR=data/profile_chroma_db
# AGENT_CHECKPOINT_DB_PATH=data/agent_checkpoints.db

# Redis 缓存（可选，TTL 单位为秒）
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
RAG_CACHE_TTL=900

# LangSmith 追踪（可选，开启时填写密钥）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shopsift
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
